# ---- AI provider (only needed for the 5 AI endpoints) ----
# Set ONE of these. The first one found is used unless AI_PROVIDER is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider (anthropic | openai | gemini | mock) and model.
# Defaults: anthropic → claude-opus-5-5, openai → gpt-5, gemini → gemini-flash-latest
AI_PROVIDER=
AI_MODEL=
# Claude only: low | medium | high | xhigh | max (default medium)
AI_EFFORT=
# Point the OpenAI adapter at any OpenAI-compatible server (Groq, OpenRouter, Together, Ollama...)
OPENAI_BASE_URL=

# ---- Access & security ----
# Comma-separated keys. When set, every request must send `x-api-key: <key>`.
API_ACCESS_KEYS=
# Let callers send their own key with x-ai-provider / x-ai-key / x-ai-model headers (default true).
# Set to false on a deployment that uses your own server-side key.
ALLOW_BYOK=true
# CORS origin (default *)
CORS_ORIGIN=*

# ---- Safety ----
# Override crisis resources returned by safety checks, e.g. for your country:
# CRISIS_RESOURCES_JSON=[{"region":"PK","name":"Emergency","contact":"Call 1122"}]
CRISIS_RESOURCES_JSON=
